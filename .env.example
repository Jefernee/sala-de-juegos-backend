# ============================================
# Variables de entorno — Sala de Juegos Backend
# Copiá este archivo a .env y completá los valores reales.
# El .env real NUNCA se sube al repo (está en .gitignore).
# ============================================

# --- Base de datos ---
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nombre-db

# --- Servidor ---
PORT=8000

# --- Autenticación ---
JWT_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# --- Cloudinary (imágenes) ---
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Frontend ---
FRONTEND_URL=https://tu-frontend.netlify.app

# ============================================
# Notificaciones por WhatsApp (WAHA)
# Ver utils/notificacionesWhatsApp.js
# ============================================
# 'true' para activar los avisos automáticos de fin de sesión. Cualquier otro
# valor (o vacío) los apaga sin tocar código.
NOTIFICACIONES_WHATSAPP_ENABLED=false

# ============================================
# Tareas de arranque (migraciones + backfills)
# ============================================
# Son arreglos de datos de una sola vez que ya se aplicaron; solo quedan como
# red de seguridad. Corren en segundo plano tras arrancar. Poné 'false' para
# OMITIRLAS (recomendado en LOCAL, que se conecta al Atlas de producción).
# En producción dejala sin definir o en 'true'.
EJECUTAR_MIGRACIONES=true

# --- Conexión a WAHA (WhatsApp HTTP API en la VM propia) ---
# El aviso se manda a UN GRUPO de WhatsApp desde el número de la sala.
WAHA_URL=http://157.151.183.29:3000
WAHA_API_KEY=pon-aca-la-x-api-key-de-waha
WAHA_SESSION=default
# ID del grupo destino (formato "...@g.us"). Se saca listando los grupos con la
# API de WAHA: GET {WAHA_URL}/api/{WAHA_SESSION}/groups
WAHA_CHAT_ID=120363403807399844@g.us

# ============================================
# Alertas por correo (Resend)
# Ver utils/alertasEmail.js
# ============================================
# Avisan por CORREO cuando algo se rompe: un aviso de WhatsApp que no se pudo
# entregar, o un error grave del backend. Es el canal de respaldo, porque
# justamente cuando falla WhatsApp no se puede avisar por WhatsApp.
# Probar con: node scripts/testAlertaEmail.js
ALERTAS_EMAIL_ENABLED=false
# API key de Resend (https://resend.com → API Keys). Empieza con "re_".
RESEND_API_KEY=re_pon-aca-la-api-key-de-resend
# A quién le llegan las alertas.
ALERTAS_EMAIL_TO=jefernee50@gmail.com
# Remitente. Con el dominio de pruebas de Resend (onboarding@resend.dev) solo se
# le puede escribir a la cuenta dueña de la API key, que es justo lo que
# necesitamos. Con dominio propio verificado se puede poner cualquier remitente.
ALERTAS_EMAIL_FROM=Sala de Juegos <onboarding@resend.dev>
